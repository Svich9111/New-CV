# Тестовый стенд «Чувства AI» (задача 0.8): шаблон без значений. Рабочая копия —
# infra/deploy/.env на сервере (права 600, владелец feelings; не коммитится — .gitignore).
#
# Проще всего заполнить секреты скриптом — он пишет их прямо в .env и НИЧЕГО не печатает:
#   python3 -I infra/deploy/gen_secrets.py            (из каталога репозитория)
# Ниже у каждого секрета — команда генерации вручную (печатает значение в терминал: не
# запускайте её в записываемом сеансе и не копируйте вывод в чаты и тикеты).
# Все значения — без кавычек и пробелов. Пароли и секреты — только A-Z a-z 0-9 _ -
# (подставляются в URL без кодирования).

# --- Окружение --------------------------------------------------------------------------
# staging: проверки продуктива включены, опрос бота (app.bot.poll) запрещён. Внимание:
# staging требует проверенного оператором списка контактов помощи (АР-33) — docs/DEPLOY.md, шаг 0.
FEELINGS_ENV=staging
# Домен стенда (A-запись на IP сервера). Caddy получает сертификат автоматически.
FEELINGS_DOMAIN=
# Почта для уведомлений Let's Encrypt (сроки сертификата). Можно служебный ящик.
FEELINGS_ACME_EMAIL=
# Метка образов (обычно короткий хеш коммита): откат — сборка/запуск с прежней меткой.
FEELINGS_IMAGE_TAG=staging

# --- PostgreSQL -------------------------------------------------------------------------
# Пароль суперпользователя postgres (миграции и infra/db/roles.sql). Действует только при
# первом создании тома БД; смена позже — ALTER ROLE postgres PASSWORD внутри контейнера.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Пароли ролей входа (infra/db/roles.sql; URL подключения собирает compose):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"      — для каждого свой
FEELINGS_API_DB_PASSWORD=
FEELINGS_WORKER_DB_PASSWORD=
FEELINGS_ADMIN_DB_PASSWORD=

# --- Telegram ---------------------------------------------------------------------------
# Токен бота от @BotFather (вводится вручную; тестовый бот, не продуктивный).
FEELINGS_TELEGRAM_BOT_TOKEN=
# Имя бота без «@».
FEELINGS_BOT_USERNAME=
# Секрет вебхука (32–256 символов A-Z a-z 0-9 _ -):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FEELINGS_TELEGRAM_WEBHOOK_SECRET=
# Секрет подписи сессии (не короче 32 символов):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FEELINGS_SESSION_SECRET=

# --- Шифрование и память ----------------------------------------------------------------
# Набор ключей шифрования «id:base64url(32 байта)» через запятую и id текущего (docs/ADMIN.md §6):
#   python3 -c "import base64,os; print('k1:' + base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
FEELINGS_ENCRYPTION_KEYS=
FEELINGS_ENCRYPTION_KEY_ID=k1
# Ключ отпечатков памяти (отдельный секрет; прежние — в _OLD, не удалять никогда, АР-37):
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FEELINGS_MEMORY_FINGERPRINT_KEY=
FEELINGS_MEMORY_FINGERPRINT_KEYS_OLD=

# --- Модели -----------------------------------------------------------------------------
# Ключ OpenRouter (вводится вручную). Без него воркер памяти не стартует, ответы агента — ошибка.
OPENROUTER_API_KEY=
FEELINGS_LLM_WRITER_MODEL=anthropic/claude-sonnet-5.5
FEELINGS_LLM_CLASSIFIER_MODEL=anthropic/claude-haiku-5.5

# --- Админ-API базы знаний (АР-39) --------------------------------------------------------
# Только SHA-256 (hex) токенов через запятую; сам токен (≥ 32 случайных байт) на сервере не
# хранится. Пусто — админ-API закрыт. Токен и хеш:
#   python3 -c "import secrets,hashlib;t=secrets.token_urlsafe(32);print(t);print(hashlib.sha256(t.encode()).hexdigest())"
# (gen_secrets.py кладёт токен в infra/deploy/admin-token.txt с правами 600 — передать
# администратору защищённым каналом и удалить файл.)
FEELINGS_ADMIN_TOKEN_SHA256=

# --- Пределы ----------------------------------------------------------------------------
FEELINGS_CHAT_DAILY_LIMIT=100
FEELINGS_MAX_REQUEST_BODY_BYTES=1048576
