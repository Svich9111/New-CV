{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "-q",
        "-p",
        "3.13",
        "--from",
        "serena-agent==2.1.0",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd",
        "--agent-interface",
        "tools",
        "--enable-web-dashboard",
        "false"
      ],
      "env": {
        "SERENA_USAGE_REPORTING": "false"
      }
    }
  }
}
