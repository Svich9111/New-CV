# Шаблон. Реальные значения — только в .env (не коммитится) или в хранилище секретов.
# Окружение. Без переменной сервис считает себя продуктивом (проверки продуктива включены,
# опрос бота запрещён). Для локальной разработки — dev (или test/local): только в них разрешён
# опрос python -m app.bot.poll (удаляет вебхук бота) и непроверенный список контактов помощи.
FEELINGS_ENV=dev
# Приложение — под ролью входа feelings_api (не суперпользователь, АР-10).
FEELINGS_DATABASE_URL=postgresql+asyncpg://feelings_api:CHANGE_ME@localhost:5432/feelings
# Миграции — под владельцем схемы.
FEELINGS_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/feelings
FEELINGS_REDIS_URL=redis://localhost:6379/0
# Без токена бота и секрета сессии от 32 символов сервис не стартует (задача 1.1).
FEELINGS_TELEGRAM_BOT_TOKEN=
FEELINGS_SESSION_SECRET=
# Имя бота без «@» для ссылок-приглашений t.me/<бот>?startapp=<токен> (задача 1.3).
FEELINGS_BOT_USERNAME=
# Секрет вебхука бота (32–256 символов A-Z a-z 0-9 _ -) и адрес Mini App (https) — задача 1.4.
FEELINGS_TELEGRAM_WEBHOOK_SECRET=
FEELINGS_WEBAPP_URL=
# Шифрование текстов при хранении (задача 4.2): набор ключей «id:base64url(32 байта)» через
# запятую и id текущего ключа. Без них сервис не стартует. Новый ключ:
#   cd backend && uv run python -c "from app.core.crypto import generate_key_entry as g; print(g('k1'))"
# Ротация: добавить новый ключ в набор и сделать его текущим; старый оставить до перешифровки (4.7).
FEELINGS_ENCRYPTION_KEYS=
FEELINGS_ENCRYPTION_KEY_ID=
# Отпечатки записей памяти (задача 2.4, АР-36): отдельный секрет — base64url не короче 32 байт;
# не ротируется вместе с ключами шифрования. При смене прежний ключ переносится в _OLD (через
# запятую) и НЕ УДАЛЯЕТСЯ никогда (АР-37): без него удалённое при старом ключе извлечётся снова.
# Новый ключ:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FEELINGS_MEMORY_FINGERPRINT_KEY=
FEELINGS_MEMORY_FINGERPRINT_KEYS_OLD=
# Фоновый воркер памяти (задача 2.4): пауза, после которой сессия чата считается завершённой
# (минуты), срок аренды задачи (минуты), период сжатия (часы), предел попыток.
FEELINGS_MEMORY_SESSION_GAP_MIN=30
FEELINGS_MEMORY_LEASE_MIN=10
FEELINGS_MEMORY_COMPACT_EVERY_H=168
FEELINGS_MEMORY_MAX_ATTEMPTS=5
# Роль входа воркера (член feelings_worker и feelings_app, NOINHERIT; Б-69). Создаёт
# infra/db/roles.sql; запуск воркеров вне Docker: cd backend && uv run python -m app.workers.memory
FEELINGS_WORKER_DATABASE_URL=postgresql+asyncpg://feelings_worker_login:CHANGE_ME@localhost:5432/feelings
# Личный чат (задача 2.1): дневной лимит реплик агенту на пользователя (сутки UTC, счётчик в
# Redis), интервал строк поддержания соединения SSE (секунды), модели OpenRouter по ролям.
FEELINGS_CHAT_DAILY_LIMIT=100
FEELINGS_CHAT_KEEPALIVE_S=15
FEELINGS_LLM_WRITER_MODEL=anthropic/claude-sonnet-5.5
FEELINGS_LLM_CLASSIFIER_MODEL=anthropic/claude-haiku-5.5
# Ключ OpenRouter (без префикса FEELINGS_): без него ответ агента — событие error `internal`.
OPENROUTER_API_KEY=
# Админ-API базы знаний (задача 2.6): только SHA-256 (hex) токенов администратора через запятую
# (ротация); сам токен — случайная строка ≥ 32 байт, на сервере не хранится. Новый токен и хеш:
#   python3 -c "import secrets,hashlib;t=secrets.token_urlsafe(32);print(t);print(hashlib.sha256(t.encode()).hexdigest())"
# Пусто — админ-API закрыт. Подключение администратора — роль входа, член feelings_admin (Б-75).
FEELINGS_ADMIN_TOKEN_SHA256=
FEELINGS_ADMIN_DATABASE_URL=postgresql+asyncpg://feelings_admin_login:CHANGE_ME@localhost:5432/feelings
# Предел тела запроса (байты) для всех путей, кроме загрузки материала базы знаний.
FEELINGS_MAX_REQUEST_BODY_BYTES=1048576
# Пароли ролей входа для infra/db/roles.sql и make dev-up / make db-roles (приложение их не
# читает: оно берёт пароль из URL выше — значения должны совпадать). Не короче 32 символов
# A-Z a-z 0-9 _ - (подставляются в URL без кодирования); пустой — роль не создаётся:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FEELINGS_WORKER_DB_PASSWORD=
FEELINGS_ADMIN_DB_PASSWORD=
FEELINGS_API_DB_PASSWORD=
